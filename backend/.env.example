APP_ENV=development
DEBUG=true
DATABASE_URL=sqlite:///./validrift.db
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080,http://127.0.0.1:8080
SEED_DEMO=true

# FINAL HACKATHON MODE: keep this as live and provide your real Hindsight credentials.
HINDSIGHT_MODE=live
HINDSIGHT_API_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=validrift-demo
HINDSIGHT_RECALL_BUDGET=mid
HINDSIGHT_RECALL_MAX_TOKENS=2500
HINDSIGHT_TIMEOUT_SECONDS=60

# Demo validity thresholds. 3 successes keeps Pressure +8% at SUPPORTED with 2/2,
# while historical Temperature +5C at 4/4 can be VALIDATED in Film-A.
VALIDATED_MIN_SUCCESSES=3
DRIFT_MIN_FAILURES=2

# After adding credentials, run: python scripts/sync_hindsight.py
