# Validrift backend environment — copy to backend/.env and fill in secrets.
# NEVER commit backend/.env.

APP_ENV=development
DEBUG=true
DATABASE_URL=sqlite:///./validrift.db
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
SEED_DEMO=true

# --- Hindsight (persistent memory) ---
# Live mode needs a real API key. Without it the backend still runs, but
# RETAIN/RECALL/REFLECT degrade gracefully (see README).
HINDSIGHT_MODE=live
HINDSIGHT_API_URL=https://api.hindsight.vectorize.io
HINDSIGHT_API_KEY=<paste-your-key-here>
HINDSIGHT_BANK_ID=validrift-demo
HINDSIGHT_RECALL_BUDGET=mid
HINDSIGHT_RECALL_MAX_TOKENS=2500
HINDSIGHT_TIMEOUT_SECONDS=60

# --- Deterministic Validity Engine thresholds ---
VALIDATED_MIN_SUCCESSES=3
DRIFT_MIN_FAILURES=2
